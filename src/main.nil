// ============================================================================
// 🖥️ Onuron OS Terminal Main Application Entry
// Written in Nilang (নীলাং ভাষায় সম্পূর্ণ টার্মিনাল সিস্টেম)
// Repository: https://github.com/joysriramsarkar/onuronOS
// Language Spec: https://github.com/joysriramsarkar/nilLang
// ============================================================================

let TERMINAL_NAME = "Onuron OS Terminal CLI";
let TERMINAL_VERSION = "2.5.0";
let DEFAULT_USER = "nilos";

let currentDirectory = cwd();
let activeTabName = "tty1";

let formatPromptPath = fn(path) {
    let p = path;
    if (len(p) > 25) {
        return "..." + substr(p, len(p) - 20, 20);
    }
    return p;
};

let getPromptSymbol = fn() {
    let displayPath = formatPromptPath(currentDirectory);
    return DEFAULT_USER + ":" + displayPath + "$ ";
};

let handleSysInfo = fn() {
    puts("🖥️ " + TERMINAL_NAME + " v" + TERMINAL_VERSION);
    puts("• Kernel: NilOS-Linux 6.8.0-arm64-onuron (Host Bridge Active)");
    puts("• Architecture: x86_64 / AArch64 Mobile & Desktop");
    puts("• Runtime: Nilang Native VM (Go + Rust Core)");
    puts("• Python Engine: Connected to Native Python 3.14 Runtime");
    puts("• Storage: Native Filesystem Bridge (" + currentDirectory + ")");
    return true;
};

let handleHelp = fn() {
    puts("📋 [Onuron OS Terminal Help System]");
    puts("  • ls, ls -la     : List real directory files & folders");
    puts("  • pwd            : Print current working directory");
    puts("  • cd <folder>    : Change directory (e.g. cd src, cd .., cd dist)");
    puts("  • mkdir <folder> : Create new directory on disk");
    puts("  • touch <file>   : Create empty file on disk");
    puts("  • cat <file>     : Read and display real file contents");
    puts("  • nano <file>    : Interactive text editor (enter lines, type ':wq' to save)");
    puts("  • echo <text>    : Display text or write to file (e.g. echo hello > a.txt)");
    puts("  • rm <file>      : Remove file or directory");
    puts("  • python <file>  : Execute Python script file through real Python engine");
    puts("  • python -c '...' : Execute inline Python code");
    puts("  • python         : Launch interactive Python 3 REPL (type 'exit()' to return)");
    puts("  • sysinfo        : Display system architecture & engine info");
    puts("  • services       : List active Onuron OS system daemons");
    puts("  • mem            : Display memory statistics");
    puts("  • clear          : Clear terminal screen");
    puts("  • exit / quit    : Close and exit terminal");
    return true;
};

let dispatchCommand = fn(rawInput) {
    let cmd = trim(rawInput);
    if (cmd == "") {
        return false;
    }

    let lowerCmd = lower(cmd);

    if (lowerCmd == "sysinfo") { return handleSysInfo(); }
    if (lowerCmd == "help") { return handleHelp(); }
    if (lowerCmd == "pwd") { puts(cwd()); return true; }
    if (lowerCmd == "clear") { clear(); return true; }

    if (lowerCmd == "services") {
        puts("⚙️ Onuron OS Active Services & Daemons:");
        puts("  • softbusd.service        [active / running]");
        puts("  • nilpkg-server.service   [active / listening on :8080]");
        puts("  • compositor.service      [active / direct-rendering]");
        puts("  • netd.service            [idle]");
        return true;
    }

    if (lowerCmd == "mem") {
        puts("💾 Memory Status: Total: 8192 MB | Used: 2140 MB | Free: 6052 MB");
        return true;
    }

    if (lowerCmd == "python") {
        puts("🐍 Launching Python 3 Interactive REPL (type 'exit()' to return)...");
        exec("python", "-q");
        return true;
    }

    if (hasPrefix(lowerCmd, "python ")) {
        let pyArg = trim(substr(cmd, 7));
        if (hasPrefix(pyArg, "-c ")) {
            let codeStr = trim(trim(substr(pyArg, 3)), "\"'");
            exec("python", "-c", codeStr);
        } else {
            if (fileExists(pyArg)) {
                puts("🐍 Executing Python script: " + pyArg);
                exec("python", pyArg);
            } else {
                puts("🐍 python: can't open file '" + pyArg + "': [Errno 2] No such file or directory");
            }
        }
        return true;
    }

    if (lowerCmd == "ls" || lowerCmd == "ls -la" || lowerCmd == "ls -l") {
        let entries = listDir(".");
        let i = 0;
        let lineOut = "";
        while (i < len(entries)) {
            let name = entries[i];
            let icon = "📄 ";
            if (hasSuffix(name, "/")) {
                icon = "📁 ";
            } else if (hasSuffix(name, ".py")) {
                icon = "🐍 ";
            } else if (hasSuffix(name, ".apk") || hasSuffix(name, ".nilax")) {
                icon = "📦 ";
            } else if (hasSuffix(name, ".exe")) {
                icon = "⚙️ ";
            }
            lineOut = lineOut + icon + name + "  ";
            if ((i + 1) % 3 == 0) {
                puts(lineOut);
                lineOut = "";
            }
            let i = i + 1;
        }
        if (lineOut != "") {
            puts(lineOut);
        }
        return true;
    }

    if (hasPrefix(lowerCmd, "cd ")) {
        let target = trim(substr(cmd, 3));
        if (target == "~" || target == "") {
            chdir(".");
        } else {
            let ok = chdir(target);
            if (!ok) {
                puts("cd: " + target + ": No such file or directory");
            }
        }
        currentDirectory = cwd();
        return true;
    }

    if (hasPrefix(lowerCmd, "cat ")) {
        let targetFile = trim(substr(cmd, 4));
        if (fileExists(targetFile)) {
            let content = readFile(targetFile);
            puts(content);
        } else {
            puts("cat: " + targetFile + ": No such file or directory");
        }
        return true;
    }

    if (hasPrefix(lowerCmd, "nano ")) {
        let targetFile = trim(substr(cmd, 5));
        puts("📝 Onuron Nano v1.0 - Editing: " + targetFile);
        puts("💡 Enter text line by line. Type ':wq' on a new line to save and exit.");
        let initial = "";
        if (fileExists(targetFile)) {
            initial = readFile(targetFile);
            puts("--- Current Content ---");
            puts(initial);
            puts("--- Add/Edit lines below (or type :wq to finish) ---");
        }
        let editing = true;
        let fileBuffer = initial;
        while (editing) {
            let lineInput = input("");
            if (lineInput == null) {
                editing = false;
            } else {
                let trimmedLine = trim(lineInput);
                if (trimmedLine == ":wq" || trimmedLine == ":q" || trimmedLine == "EOF") {
                    editing = false;
                } else {
                    if (fileBuffer == "") {
                        fileBuffer = lineInput;
                    } else {
                        fileBuffer = fileBuffer + "\n" + lineInput;
                    }
                }
            }
        }
        writeFile(targetFile, fileBuffer);
        puts("💾 Saved changes to: " + targetFile);
        return true;
    }

    if (hasPrefix(lowerCmd, "mkdir ")) {
        let dirName = trim(substr(cmd, 6));
        let ok = makeDir(dirName);
        if (ok) {
            puts("📁 Created directory: " + dirName);
        } else {
            puts("mkdir: cannot create directory '" + dirName + "'");
        }
        return true;
    }

    if (hasPrefix(lowerCmd, "touch ")) {
        let fileName = trim(substr(cmd, 6));
        if (!fileExists(fileName)) {
            writeFile(fileName, "");
        }
        puts("📄 Created file: " + fileName);
        return true;
    }

    if (hasPrefix(lowerCmd, "rm ")) {
        let target = trim(substr(cmd, 3));
        if (fileExists(target)) {
            removeFile(target);
            puts("🗑️ Removed: " + target);
        } else {
            puts("rm: cannot remove '" + target + "': No such file or directory");
        }
        return true;
    }

    if (hasPrefix(lowerCmd, "echo ")) {
        let rawEcho = trim(substr(cmd, 5));
        if (contains(rawEcho, ">")) {
            let parts = split(rawEcho, ">");
            let content = trim(parts[0]);
            let target = trim(parts[1]);
            writeFile(target, content + "\n");
            puts("📝 Wrote to " + target);
        } else {
            puts(rawEcho);
        }
        return true;
    }

    puts("nilos: command not found: " + cmd + " (type 'help' for available commands)");
    return false;
};

let main = fn() {
    puts("=================================================");
    puts("💻 " + TERMINAL_NAME + " v" + TERMINAL_VERSION);
    puts("   Multi-Tab Shell & Native Python 3 Engine");
    puts("=================================================");
    puts("🚀 Connected: " + currentDirectory);
    puts("💡 Type 'help' for available commands, 'exit' to quit.\n");

    let running = true;
    while (running) {
        let p = "[" + activeTabName + "] " + getPromptSymbol();
        let raw = input(p);
        if (raw == null) {
            running = false;
        } else {
            let line = trim(raw);
            if (line != "") {
                if (line == "exit" || line == "quit") {
                    puts("👋 Exiting Onuron Terminal. Goodbye!");
                    running = false;
                } else {
                    dispatchCommand(line);
                }
            }
        }
    }
    return 0;
};

main();
