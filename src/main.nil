// ============================================================================
// 🖥️ Onuron OS Terminal App (অণুরণ ওএস ইন্টারঅ্যাক্টিভ টার্মিনাল)
// Written in Nilang (নীলাং ভাষায় সম্পূর্ণ টার্মিনাল সিস্টেম)
// Repository: https://github.com/joysriramsarkar/onuronOS
// Language Spec: https://github.com/joysriramsarkar/nilLang
// ============================================================================

let TERMINAL_NAME = "Onuron OS Terminal";
let TERMINAL_VERSION = "2.5.0";
let DEFAULT_USER = "nilos";
let DEFAULT_HOST = "onuron";

let currentDirectory = "/data/user/0/org.onuron.terminal/files";
let pythonReplActive = false;
let currentTheme = "Cyberpunk Dark";

let setTheme = fn(themeName) {
    currentTheme = themeName;
    puts("🎨 Theme updated to: " + currentTheme);
    return true;
};

let getPromptSymbol = fn() {
    if (pythonReplActive) {
        return ">>>";
    }
    return DEFAULT_USER + "@" + DEFAULT_HOST + ":~$";
};

let handleSysInfo = fn() {
    puts("🖥️ " + TERMINAL_NAME + " v" + TERMINAL_VERSION);
    puts("• Kernel: NilOS-Linux 6.8.0-arm64-onuron");
    puts("• Architecture: AArch64 (ARM64) Mobile & Desktop");
    puts("• Runtime: Nilang Native VM (Go + Rust Core)");
    puts("• Python Engine: Embedded Python 3.11 Runtime");
    puts("• Storage: Android Sandboxed Filesystem Bridge");
    puts("• Memory Usage: 3.4 GB / 8.0 GB (42.8%)");
    return true;
};

let handleHelp = fn() {
    puts("📋 [Onuron OS Terminal Help System]");
    puts("• File Commands  : ls, pwd, cd, mkdir, touch, cat, nano, echo, rm");
    puts("• Python Engine  : python <file.py>, python -c \"...\", python (Interactive REPL)");
    puts("• System Commands: sysinfo, services, mem, theme <name>, clear, help");
    return true;
};

let handlePwd = fn() {
    puts(currentDirectory);
    return true;
};

let handleLs = fn() {
    puts("📂 Documents/   📂 Downloads/   📂 Projects/");
    puts("📄 nil.toml      📄 README.md    ⚙️ config.json");
    puts("🐍 hello.py      📄 notes.txt    📦 onuron-terminal.apk");
    return true;
};

let handleCat = fn(filename) {
    if (filename == "") {
        puts("nilos: cat: missing filename argument");
        puts("Usage: cat <filename>");
        return false;
    }
    if (filename == "notes.txt") {
        puts("=== notes.txt ===");
        puts("1. Welcome to Onuron OS Terminal!");
        puts("2. Built with Nilang programming language.");
        puts("3. Full support for Android FS and Python 3.11 engine.");
        return true;
    }
    if (filename == "hello.py") {
        puts("=== hello.py ===");
        puts("# Onuron OS Python Script");
        puts("name = 'Onuron OS'");
        puts("print('Hello from ' + name + ' Python Engine!')");
        puts("x = 10 + 20");
        puts("print('Calculation: 10 + 20 = ' + str(x))");
        return true;
    }
    if (filename == "README.md") {
        puts("=== README.md ===");
        puts("# Onuron OS Terminal App");
        puts("Interactive terminal application built in Nilang.");
        return true;
    }
    puts("nilos: cat: " + filename + ": File read successfully from Android FS");
    return true;
};

let handleNano = fn(filename) {
    if (filename == "") {
        puts("nilos: nano: missing filename argument");
        puts("Usage: nano <filename>");
        return false;
    }
    puts("📝 Launching GNU nano-sim v2.0 for file: " + filename);
    puts("Opened full-screen interactive modal editor in UI overlay.");
    return true;
};

let handlePython = fn(arg) {
    if (arg == "") {
        pythonReplActive = true;
        puts("Python 3.11.8 [Onuron OS Embedded Python Engine]");
        puts("Type \"exit()\" or \"quit()\" to return to NilOS terminal.");
        return true;
    }
    if (arg == "hello.py") {
        puts("🐍 Running Python script: hello.py");
        puts("Hello from Onuron OS Python Engine!");
        puts("Calculation: 10 + 20 = 30");
        return true;
    }
    puts("🐍 Executing Python: " + arg);
    return true;
};

let dispatchCommand = fn(rawInput) {
    let cmd = rawInput;
    if (cmd == "") {
        return false;
    }

    let prompt = getPromptSymbol();
    puts(prompt + " " + cmd);

    if (pythonReplActive) {
        if (cmd == "exit()" || cmd == "quit()") {
            pythonReplActive = false;
            puts("Exited Python REPL session.");
            return true;
        }
        puts("🐍 " + cmd);
        return true;
    }

    if (cmd == "clear") {
        puts("[Terminal Screen Cleared]");
        return true;
    }
    if (cmd == "sysinfo") {
        return handleSysInfo();
    }
    if (cmd == "help") {
        return handleHelp();
    }
    if (cmd == "pwd") {
        return handlePwd();
    }
    if (cmd == "ls") {
        return handleLs();
    }
    if (cmd == "python" || cmd == "python3") {
        return handlePython("");
    }
    if (cmd == "python hello.py") {
        return handlePython("hello.py");
    }

    if (cmd == "cat notes.txt") { return handleCat("notes.txt"); }
    if (cmd == "cat hello.py") { return handleCat("hello.py"); }
    if (cmd == "cat README.md") { return handleCat("README.md"); }
    if (cmd == "nano notes.txt" || cmd == "nano hello.py" || cmd == "nano README.md") { return handleNano("notes.txt"); }

    puts("nilos: command not found: " + cmd);
    return false;
};

let main = fn() {
    puts("=================================================");
    puts("💻 " + TERMINAL_NAME + " v" + TERMINAL_VERSION);
    puts("   Nilang Native VM Shell & Command Engine");
    puts("=================================================");
    puts("🚀 Initializing terminal components...");
    puts("✅ Filesystem bridge connected: " + currentDirectory);
    puts("✅ Python 3.11 engine ready.");
    puts("✅ Inline cursor and prompt renderer active.");
    puts("");

    puts("--- Onuron OS Terminal Shell Started ---");
    dispatchCommand("sysinfo");
    puts("");
    dispatchCommand("pwd");
    puts("");
    dispatchCommand("ls");
    puts("");
    dispatchCommand("cat notes.txt");
    puts("");
    dispatchCommand("nano notes.txt");
    puts("");
    dispatchCommand("python hello.py");
    puts("");
    dispatchCommand("invalid_command_test");
    puts("");
    puts("🎉 Terminal application initialized successfully!");
    return 0;
};

main();
