let createSubprocess = fn(binary, args) {
    puts("🚀 Spawning process: " + binary);
    return {
        "pid": 1042,
        "status": "running",
        "binary": binary
    };
};

let executeBinary = fn(cmd, args) {
    puts("⚡ Executing native binary in PTY bridge: " + cmd);
    return 0;
};
